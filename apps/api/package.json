{
  "name": "@gest-finance/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "predev": "prisma generate && prisma migrate deploy && node --env-file-if-exists=.env scripts/setup-roles.mjs",
    "dev": "node --env-file=.env --watch --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:roles": "node --env-file-if-exists=.env scripts/setup-roles.mjs",
    "market:check": "node --import @swc-node/register/esm-register scripts/market-check.ts",
    "payslip:debug": "node --import @swc-node/register/esm-register scripts/payslip-debug.ts",
    "pretest": "prisma generate && prisma migrate deploy && node --env-file-if-exists=.env scripts/setup-roles.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@gest-finance/finance-core": "workspace:*",
    "@gest-finance/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.7",
    "@prisma/client": "^6.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.7.0",
    "argon2": "^0.41.0",
    "otplib": "^12.0.1",
    "pdfjs-dist": "4.10.38",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "fastify": "^5.12.7",
    "pdf-lib": "^1.17.1",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
