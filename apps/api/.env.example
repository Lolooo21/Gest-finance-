# Copier en apps/api/.env (fichier ignoré par Git). Valeurs de développement uniquement.
DATABASE_URL=postgresql://gest:gest_dev@localhost:5432/gest_finance
# Au moins 32 caractères ; en production, générer une valeur aléatoire unique.
JWT_SECRET=dev-secret-dev-secret-dev-secret-123456
PORT=3000
# Clé de chiffrement des champs sensibles (IBAN) : 32 octets en base64. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Notifications push (optionnel). Générer les clés avec : cd apps/api && pnpm exec web-push generate-vapid-keys
# Sans ces clés, le rappel hebdomadaire s'affiche uniquement dans l'application.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:vous@example.com
# REMINDER_SCHEDULER=off   # désactive le planificateur interne (vérification chaque minute)

# Indicateurs de marché (BCE, Eurostat) : le serveur les télécharge une fois par jour. Aucune donnée de votre foyer n'est envoyée.
# MARKET_REFRESH=off   # désactive tout appel sortant (les valeurs affichées peuvent alors être anciennes)
