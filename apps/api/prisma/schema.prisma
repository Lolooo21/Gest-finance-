generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADULT
  CHILD
}

model Household {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  audits    AuditLog[]
  accounts  BankAccount[]
  transactions Transaction[]
  recurringRules RecurringRule[]
}

model User {
  id            String   @id @default(uuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email         String   @unique
  displayName   String
  passwordHash  String
  role          Role
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  refreshTokens RefreshToken[]
  reminder      ReminderSetting?
  pushSubscriptions PushSubscription[]

  @@index([householdId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String?
  action      String
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model BankAccount {
  id                  String   @id @default(uuid())
  householdId         String
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name                String
  type                AccountType
  initialBalanceCents Int
  /// IBAN chiffré AES-256-GCM (format iv.tag.données en base64)
  ibanEncrypted       String?
  createdAt           DateTime @default(now())
  transactions        Transaction[]
  recurringRules      RecurringRule[]

  @@index([householdId])
}

model Transaction {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accountId   String
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Montant signé en centimes : positif = entrée, négatif = sortie
  amountCents Int
  date        DateTime @db.Date
  label       String
  createdAt   DateTime @default(now())

  @@index([householdId, date])
  @@index([accountId])
}

model RecurringRule {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accountId   String
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  frequency   Frequency
  start       DateTime @db.Date
  end         DateTime? @db.Date
  createdAt   DateTime @default(now())

  @@index([householdId])
}

model ReminderSetting {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  /// 1 = lundi … 7 = dimanche
  weekday        Int      @default(7)
  hour           Int      @default(18)
  timezone       String   @default("Europe/Paris")
  /// Activation / dernière modification : aucun rappel rétroactif avant cette date
  since          DateTime @default(now())
  lastDoneAt     DateTime?
  lastReminderAt DateTime?
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
